# Copy this file to .env and fill in the values.
# The .env file and secrets/ folder are git-ignored.

PORT=3001

# Firebase project that hosts Firestore
FIREBASE_PROJECT_ID=ecf-hr

# Path inside the container to the service account JSON key
# Mount the actual file via docker-compose volumes (see docker-compose.yml)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json

# IP:4370 poller (ZKTeco / ZK-compatible devices)
IP_POLL_INTERVAL_MS=90000
IP_POLL_TIMEOUT_MS=300000
