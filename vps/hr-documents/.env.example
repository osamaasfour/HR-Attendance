# Copy to .env and fill in values.

PORT=3002

FIREBASE_PROJECT_ID=ecf-hr
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json

# Absolute path inside the container for uploaded files
DOCUMENTS_DIR=/data/hr-documents

# Public base URL (must match nginx path). Used when building file URLs.
PUBLIC_BASE_URL=https://hr.ecfshipment.com

# Max upload size in bytes (default 50MB)
MAX_FILE_BYTES=52428800

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=https://ecf-hr.web.app,https://ecf-hr.firebaseapp.com,http://localhost:8081,http://localhost:19006
